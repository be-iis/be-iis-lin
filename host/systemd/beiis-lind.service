[Unit]
Description=BE-IIS LIN HAT daemon
After=local-fs.target
Wants=local-fs.target

[Service]
Type=simple
User=root
Group=i2c
RuntimeDirectory=beiis
RuntimeDirectoryMode=0770
UMask=0007
ExecStart=/usr/local/bin/beiis-lind --bus 1 --address 0x42 --socket /run/beiis/lin-hat.sock --mode 0660
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
